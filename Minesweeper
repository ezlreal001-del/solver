local MINE_THRESHOLD  = 0.70
local SAFE_THRESHOLD  = 0.30
local USE_PATTERNS    = true
local MINE_COUNT      = 100
local MAX_COMP_SIZE   = 32
local SOLUTION_LIMIT  = 10000000

local board = {
    cells    = {},
    revealed = {},
    flagged  = {},
    cleared  = {},
    probs    = {},
    rows     = {},
    flat     = {}
}

local state = {
    cx = nil, cz = nil,
    folder = nil, partCount = 0, partHash = "",
    tick = 0, lastTick = -1
}

local cols, rows = 0, 0

local abs, floor, huge = math.abs, math.floor, math.huge
local min, max, sort = math.min, math.max, table.sort

local function toKey(x, z) return x .. ":" .. z end
local function isNum(s) return tonumber(s) ~= nil end

local function stillHidden(c)
    if not c then return false end
    if c.kind == "clue" then return false end
    return c.hidden == true
end

-- colors
local RED       = Color3.fromRGB(255,60,60)
local RED_DIM   = Color3.fromRGB(255,160,160)
local MINT      = Color3.fromRGB(60,255,140)
local MINT_DIM  = Color3.fromRGB(160,255,200)
local HOT_RED   = Color3.fromRGB(255,80,80)
local HOT_RED2  = Color3.fromRGB(255,160,160)
local SKY       = Color3.fromRGB(80,220,255)
local SKY_DIM   = Color3.fromRGB(160,235,255)
local AMBER     = Color3.fromRGB(255,200,50)
local AMBER_DIM = Color3.fromRGB(255,225,140)
local BLACK     = Color3.fromRGB(0,0,0)

-- bit ops
local b32 = type(bit32)=="table"
local blib = type(bit)=="table"
local band, rshift, bnot, bor, lshift
if b32 then
    band=bit32.band; rshift=bit32.rshift; bnot=bit32.bnot; bor=bit32.bor; lshift=bit32.lshift
elseif blib then
    band=bit.band; rshift=bit.rshift; bnot=bit.bnot; bor=bit.bor; lshift=bit.lshift
end

local fmask = nil

local function buildMasks(sz, lists)
    local masks = {}
    if band and bor and lshift and sz <= 32 then
        fmask = sz < 32 and (2^sz)-1 or 0xFFFFFFFF
        for i = 1, #lists do
            local m = 0
            for _, j in ipairs(lists[i]) do m = bor(m, lshift(1, j-1)) end
            masks[i] = m
        end
        return masks, "n"
    elseif band then
        fmask = nil
        for i = 1, #lists do
            local a = {}
            for _, j in ipairs(lists[i]) do
                local c = floor((j-1)/32)+1; local b = (j-1)%32
                a[c] = bor(a[c] or 0, lshift(1, b))
            end
            masks[i] = a
        end
        return masks, "c"
    else
        fmask = nil
        for i = 1, #lists do
            local s = {}
            for _, j in ipairs(lists[i]) do s[j] = true end
            masks[i] = s
        end
        return masks, "s"
    end
end

local function subset(A, B, mode)
    if mode=="n" then return band(A,B)==A
    elseif mode=="c" then
        for i = 1, math.max(#A,#B) do
            if band(A[i] or 0, B[i] or 0) ~= (A[i] or 0) then return false end
        end
        return true
    else
        for k in pairs(A) do if not B[k] then return false end end
        return true
    end
end

local function maskDiff(A, B, mode)
    local out = {}
    if mode=="n" then
        local invA = bnot and band(bnot(A), fmask or 0) or nil
        local d = invA ~= nil and band(B,invA) or B
        local i = 0
        while d ~= 0 do
            if band(d,1) ~= 0 then
                if invA==nil then if band(A,2^i)==0 then out[#out+1]=i+1 end
                else out[#out+1]=i+1 end
            end
            d=rshift(d,1); i=i+1
        end
    elseif mode=="c" then
        for ci = 1, #B do
            local bv=B[ci] or 0; local av=A[ci] or 0
            local na=band(bnot and bnot(av) or (0xFFFFFFFF-av),0xFFFFFFFF)
            local d=band(bv,na); local base=(ci-1)*32; local k=0
            while d~=0 do
                if band(d,1)~=0 then out[#out+1]=base+k+1 end
                d=rshift(d,1); k=k+1
            end
        end
    else
        for idx in pairs(B) do if not A[idx] then out[#out+1]=idx end end
    end
    return out
end

local function choose(n, k)
    if k<0 or k>n then return 0 end
    if k==0 or k==n then return 1 end
    if k>n-k then k=n-k end
    local r=1.0
    for i=1,k do r=r*(n-(k-i)); r=r/i end
    return r
end

local ecache={}; local eorder={}; local esize=3000; local eptr=1

local function ecachePut(k,v)
    if not ecache[k] then
        local old=eorder[eptr]; if old then ecache[old]=nil end
        eorder[eptr]=k; eptr=(eptr%esize)+1
    end
    ecache[k]=v
end
local function ecacheGet(k) return ecache[k] end
local function ecacheClear() ecache={}; eorder={}; eptr=1 end

local function compKey(constraints)
    local p={}
    for i=1,#constraints do
        local c=constraints[i]; local ix={table.unpack(c.ix)}; sort(ix)
        p[#p+1]=table.concat(ix,",")..":"..c.r
    end
    sort(p); return table.concat(p,"|")
end

local function enumerate(group, constraints, cap)
    local n = #group
    local hits = {}; for i=1,n do hits[i]=0 end
    local total=0; local lo,hi=nil,nil
    local dist={}; local perK={}
    for i=1,n do perK[i]={} end

    local vc={}; for i=1,n do vc[i]={} end
    for ci=1,#constraints do
        for _,j in ipairs(constraints[ci].ix) do vc[j][#vc[j]+1]=ci end
    end

    local ord={}; for i=1,n do ord[i]=i end
    local tgt={}
    for i=1,n do
        local m=huge
        for _,ci in ipairs(vc[i]) do
            local c=constraints[ci]; local t=min(c.r,#c.ix-c.r)
            if t<m then m=t end
        end
        tgt[i]=(#vc[i]>0) and m or huge
    end
    sort(ord,function(a,b)
        local na,nb=#vc[a],#vc[b]
        if na~=nb then return na>nb end
        return tgt[a]<tgt[b]
    end)

    local ca={}; local cu={}
    for ci=1,#constraints do ca[ci]=0; cu[ci]=#constraints[ci].ix end
    local asgn={}; for i=1,n do asgn[i]=0 end
    local stop,capped=false,false

    local function go(d, mines)
        if stop then return end
        if d>n then
            total=total+1; dist[mines]=(dist[mines] or 0)+1
            if not lo or mines<lo then lo=mines end
            if not hi or mines>hi then hi=mines end
            for i=1,n do
                if asgn[i]==1 then
                    hits[i]=hits[i]+1
                    local a=perK[i]; a[mines]=(a[mines] or 0)+1
                end
            end
            if cap and total>=cap then stop=true; capped=true end
            return
        end
        local v=ord[d]; local vcs=vc[v]
        local ok0=true
        for i=1,#vcs do
            local ci=vcs[i]; cu[ci]=cu[ci]-1
            if ca[ci]>constraints[ci].r or (ca[ci]+cu[ci])<constraints[ci].r then ok0=false end
        end
        if ok0 then asgn[v]=0; go(d+1,mines) end
        for i=1,#vcs do cu[vcs[i]]=cu[vcs[i]]+1 end
        if stop then return end
        local ok1=true
        for i=1,#vcs do
            local ci=vcs[i]; cu[ci]=cu[ci]-1; ca[ci]=ca[ci]+1
            if ca[ci]>constraints[ci].r or (ca[ci]+cu[ci])<constraints[ci].r then ok1=false end
        end
        if ok1 then asgn[v]=1; go(d+1,mines+1) end
        for i=1,#vcs do cu[vcs[i]]=cu[vcs[i]]+1; ca[vcs[i]]=ca[vcs[i]]-1 end
        asgn[v]=0
    end

    go(1,0)
    dist[0]=dist[0] or 0; for k=1,n do dist[k]=dist[k] or 0 end
    return total,hits,(lo or 0),(hi or 0),dist,perK,capped
end

local function enumerateCached(group, constraints, cap)
    local keys={}; for i=1,#group do keys[i]=group[i].k end; sort(keys)
    local k=compKey(constraints)..#group.."|"..table.concat(keys,",")
    local hit=ecacheGet(k)
    if hit then return hit.t,hit.h,hit.lo,hit.hi,hit.d,hit.pk,true,false end
    local t,h,lo,hi,d,pk,capped=enumerate(group,constraints,cap)
    if t and t>0 and not capped then
        ecachePut(k,{t=t,h=h,lo=lo,hi=hi,d=d,pk=pk})
    end
    return t,h,lo,hi,d,pk,false,capped
end

local tmpQ = {}

local function neighbors(c, kF, kC, out)
    local nbs=c.neigh; local fc=0; local n=0
    for i=1,#nbs do
        local nb=nbs[i]
        if kF[nb] then fc=fc+1
        elseif (not kC[nb]) and nb.hidden==true then n=n+1; out[n]=nb end
    end
    for i=n+1,#out do out[i]=nil end
    return n,fc
end

local mA={}; local mI={}

local function runPatterns(kF, kC)
    local any=false
    for pass=1,12 do
        local changed=false
        local meta={}; local mlists={}

        for i=1,#board.revealed do
            local cell=board.revealed[i]
            local nu,fc=neighbors(cell,kF,kC,tmpQ)
            local rem=(cell.clue or 0)-fc
            if rem>=0 and nu>0 then
                local unks={}; for j=1,nu do unks[j]=tmpQ[j] end
                meta[#meta+1]={unks=unks,rem=rem}; mlists[#mlists+1]=unks
            end
        end
        if #meta==0 then break end

        local fi={}; local fl={}; local idx=1
        for i=1,#mlists do
            for _,c in ipairs(mlists[i]) do
                if not fi[c] then fi[c]=idx; fl[idx]=c; idx=idx+1 end
            end
        end

        local mil={}
        for i=1,#meta do
            local arr={}
            for _,c in ipairs(meta[i].unks) do arr[#arr+1]=fi[c] end
            mil[i]=arr
        end

        local masks,mode=buildMasks(#fl,mil)

        for i=1,#meta do
            local A=meta[i]; local Ai=masks[i]; local sa=#A.unks
            for j=1,#meta do
                if i~=j then
                    local B=meta[j]
                    if sa<=#B.unks and subset(Ai,masks[j],mode) then
                        local di=maskDiff(Ai,masks[j],mode)
                        if #di>0 then
                            local dm=B.rem-A.rem
                            if dm==0 then
                                for d=1,#di do local c=fl[di[d]]
                                    if c and not kC[c] then kC[c]=true; board.cleared[c]=true; changed=true end
                                end
                            elseif dm==#di and dm>0 then
                                for d=1,#di do local c=fl[di[d]]
                                    if c and not kF[c] then kF[c]=true; board.flagged[c]=true; changed=true end
                                end
                            end
                        end
                    end
                end
            end
        end

        for i=1,#meta-1 do
            local A=meta[i].unks; local rA=meta[i].rem
            for a=1,#A do mA[A[a]]=true end
            for j=i+1,#meta do
                local B=meta[j].unks; local rB=meta[j].rem
                local inter,onlyA,onlyB={},{},{}
                for _,c in ipairs(B) do
                    if mA[c] then inter[#inter+1]=c; mI[c]=true else onlyB[#onlyB+1]=c end
                end
                for _,c in ipairs(A) do if not mI[c] then onlyA[#onlyA+1]=c end end
                for _,c in ipairs(inter) do mI[c]=nil end
                local nI,nA,nB=#inter,#onlyA,#onlyB
                if nI>0 or nA>0 or nB>0 then
                    local iMin=max(0,rA-nA,rB-nB); local iMax=min(nI,rA,rB)
                    if iMin<=iMax then
                        local cMax=min(nA,rA-iMin); local dMax=min(nB,rB-iMin)
                        local cMin=max(0,rA-iMax); local dMin=max(0,rB-iMax)
                        if cMax==0 and nA>0 then for _,c in ipairs(onlyA) do
                            if not kC[c] then kC[c]=true; board.cleared[c]=true; changed=true end end
                        elseif cMin==nA and nA>0 then for _,c in ipairs(onlyA) do
                            if not kF[c] then kF[c]=true; board.flagged[c]=true; changed=true end end end
                        if dMax==0 and nB>0 then for _,c in ipairs(onlyB) do
                            if not kC[c] then kC[c]=true; board.cleared[c]=true; changed=true end end
                        elseif dMin==nB and nB>0 then for _,c in ipairs(onlyB) do
                            if not kF[c] then kF[c]=true; board.flagged[c]=true; changed=true end end end
                        if iMax==0 and nI>0 then for _,c in ipairs(inter) do
                            if not kC[c] then kC[c]=true; board.cleared[c]=true; changed=true end end
                        elseif iMin==nI and nI>0 then for _,c in ipairs(inter) do
                            if not kF[c] then kF[c]=true; board.flagged[c]=true; changed=true end end end
                    end
                end
            end
            for a=1,#A do mA[A[a]]=nil end
        end

        if not changed then break end
        any=true
    end
    return any
end

local function runLocalSolver(kF, kC)
    local any=false; local maxSz=12
    local nd={}
    for i=1,#board.revealed do
        local cell=board.revealed[i]
        local nu,fc=neighbors(cell,kF,kC,tmpQ)
        local rem=(cell.clue or 0)-fc
        if rem>=0 and nu>0 then
            local unks={}; for j=1,nu do unks[j]=tmpQ[j] end
            nd[#nd+1]={unks=unks,rem=rem}
        end
    end
    if #nd<2 then return false end

    local c2n={}
    for ci=1,#nd do
        for _,c in ipairs(nd[ci].unks) do
            if not c2n[c] then c2n[c]={} end
            c2n[c][#c2n[c]+1]=ci
        end
    end
    local nbs2={}
    for ci=1,#nd do
        local nb={}
        for _,c in ipairs(nd[ci].unks) do
            if c2n[c] then for _,cj in ipairs(c2n[c]) do if cj~=ci then nb[cj]=true end end end
        end
        nbs2[ci]=nb
    end

    local solved={}
    for ci=1,#nd do
        local grp={ci}; local inG={[ci]=true}
        local uSet={}; local uList={}
        for _,c in ipairs(nd[ci].unks) do uSet[c]=true; uList[#uList+1]=c end
        local cands={}
        for nb in pairs(nbs2[ci]) do cands[#cands+1]=nb end
        sort(cands,function(a,b)
            local na,nb=0,0
            for _,c in ipairs(nd[a].unks) do if not uSet[c] then na=na+1 end end
            for _,c in ipairs(nd[b].unks) do if not uSet[c] then nb=nb+1 end end
            return na<nb
        end)
        for _,nb in ipairs(cands) do
            if not inG[nb] then
                local nc=0
                for _,c in ipairs(nd[nb].unks) do if not uSet[c] then nc=nc+1 end end
                if #uList+nc<=maxSz then
                    grp[#grp+1]=nb; inG[nb]=true
                    for _,c in ipairs(nd[nb].unks) do
                        if not uSet[c] then uSet[c]=true; uList[#uList+1]=c end
                    end
                    for nb2 in pairs(nbs2[nb]) do
                        if not inG[nb2] then
                            local nc2=0
                            for _,c in ipairs(nd[nb2].unks) do if not uSet[c] then nc2=nc2+1 end end
                            if #uList+nc2<=maxSz then
                                grp[#grp+1]=nb2; inG[nb2]=true
                                for _,c in ipairs(nd[nb2].unks) do
                                    if not uSet[c] then uSet[c]=true; uList[#uList+1]=c end
                                end
                            end
                        end
                    end
                end
            end
        end
        if #grp>=2 and #uList>=2 then
            sort(grp)
            local gk=table.concat(grp,",")
            if not solved[gk] then
                solved[gk]=true
                local lid={}; for idx,c in ipairs(uList) do lid[c]=idx end
                local cons={}
                for _,gi in ipairs(grp) do
                    local cd=nd[gi]; local ix={}
                    for _,c in ipairs(cd.unks) do ix[#ix+1]=lid[c] end
                    cons[#cons+1]={ix=ix,r=cd.rem}
                end
                local t,h,_,_,_,_,capped=enumerate(uList,cons,50000)
                if t and t>0 and not capped then
                    for idx=1,#uList do
                        local c=uList[idx]
                        if h[idx]==0 then
                            if not kC[c] then kC[c]=true; board.cleared[c]=true; any=true end
                        elseif h[idx]==t then
                            if not kF[c] then kF[c]=true; board.flagged[c]=true; any=true end
                        end
                    end
                end
            end
        end
    end
    return any
end

local function cluster(list, eps)
    local out={}
    if #list==0 then return out end
    local cc,cn=list[1],1
    for i=2,#list do
        local v=list[i]
        if abs(v-cc)<=eps then cn=cn+1; cc=cc+(v-cc)/cn
        else out[#out+1]=cc; cc=v; cn=1 end
    end
    out[#out+1]=cc
    return out
end

local function mid(t)
    if #t==0 then return nil end
    sort(t); return t[floor((#t+1)/2)]
end

local function spacing(centers)
    if #centers<2 then return 4 end
    local d={}
    for i=2,#centers do d[#d+1]=abs(centers[i]-centers[i-1]) end
    return mid(d) or 4
end

local function nearest(v, centers)
    local n=#centers; if n==0 then return -1 end
    local lo,hi=1,n
    while lo<=hi do
        local m=floor((lo+hi)/2); local cm=centers[m]
        if cm==v then return m-1 end
        if cm<v then lo=m+1 else hi=m-1 end
    end
    local bi,bd=1,huge
    for _,i in ipairs({lo-1,lo,lo+1}) do
        if i>=1 and i<=n then local d=abs(v-centers[i]); if d<bd then bd=d; bi=i end end
    end
    return bi-1
end

local function buildGrid()
    board.cells={}; board.revealed={}; board.rows={}; board.flat={}

    local root=workspace:FindFirstChild("Flag"); if not root then return false end
    local folder=root:FindFirstChild("Parts"); if not folder then return false end
    local parts=folder:GetChildren()
    local raw={}; local sy,sc=0,0
    for _,p in pairs(parts) do
        local pos=p and p.Position
        if pos then raw[#raw+1]={p=p,pos=pos}; sy=sy+pos.Y; sc=sc+1 end
    end

    local px,pz={},{}
    for i=1,#raw do px[#px+1]=raw[i].pos.X; pz[#pz+1]=raw[i].pos.Z end
    sort(px); sort(pz)
    local ex=spacing(px)*0.6; local ez=spacing(pz)*0.6
    state.cx=cluster(px,ex); state.cz=cluster(pz,ez)
    cols=#state.cx; rows=#state.cz
    local py=(sc>0) and (sy/sc) or 0

    for iz=0,rows-1 do
        for ix=0,cols-1 do
            local row=board.rows[ix]
            if not row then row={}; board.rows[ix]=row end
            local cell={
                ix=ix, iz=iz, part=nil,
                pos=Vector3.new(state.cx[ix+1] or 0, py, state.cz[iz+1] or 0),
                kind="unknown", clue=nil, k=toKey(ix,iz), hidden=true,
                neigh=nil, _sig=-1
            }
            board.cells[cell.k]=cell; row[iz]=cell; board.flat[#board.flat+1]=cell
        end
    end

    for i=1,#raw do
        local p=raw[i].p; local pos=raw[i].pos
        local ix=nearest(pos.X,state.cx); local iz=nearest(pos.Z,state.cz)
        if ix>=0 and ix<cols and iz>=0 and iz<rows then
            local cell=board.rows[ix][iz]
            if cell and not cell.part then cell.part=p; cell.pos=pos end
        end
    end

    for iz=0,rows-1 do
        for ix=0,cols-1 do
            local c=board.rows[ix][iz]; local nb={}
            for dz=-1,1 do for dx=-1,1 do
                if not(dx==0 and dz==0) then
                    local jx,jz=ix+dx,iz+dz
                    if jx>=0 and jx<cols and jz>=0 and jz<rows then
                        nb[#nb+1]=board.rows[jx][jz]
                    end
                end
            end end
            c.neigh=nb
        end
    end
    return true
end

local function gridReady()
    if state.cx and state.cz and cols>0 and rows>0 and
       board.rows and next(board.cells)~=nil then return true end
    return buildGrid()
end

local function readBoard()
    board.revealed={}
    local changed=false
    local flat=board.flat

    for i=1,#flat do
        local cell=flat[i]; local part=cell.part
        if part then
            cell.kind="unknown"; cell.hidden=true; cell.clue=nil

            local gui=part:FindFirstChild("NumberGui")
            if gui then
                local tl=gui:FindFirstChild("TextLabel")
                local v=tl and (tl.Text or tl.Value)
                local s=v and string.match(tostring(v),"^%s*(.-)%s*$") or ""
                if s~="" and isNum(s) then
                    local n=tonumber(s)
                    if n and n>=1 and n<=8 then cell.clue=n end
                end
                cell.hidden=false
            end

            if cell.clue and not cell.hidden then
                cell.kind="clue"
                board.revealed[#board.revealed+1]=cell
            end

            local sig=(cell.hidden and 1 or 0)+((cell.clue or 0)*4)
            if sig~=(cell._sig or -1) then cell._sig=sig; changed=true end
        end
    end

    if changed then state.tick=(state.tick or 0)+1 end
end

local function propagate(kF, kC)
    local q,qh={},1; local inQ={}
    for i=1,#board.revealed do local c=board.revealed[i]; q[#q+1]=c; inQ[c]=true end
    local any=false

    while qh<=#q do
        local cell=q[qh]; qh=qh+1; inQ[cell]=nil
        local nu,fc=neighbors(cell,kF,kC,tmpQ)
        if nu>0 then
            local rem=(cell.clue or 0)-fc
            if rem==0 then
                for u=1,nu do local c=tmpQ[u]
                    if not kC[c] then
                        kC[c]=true; board.cleared[c]=true; any=true
                        for _,nb in ipairs(c.neigh) do
                            if nb.kind=="clue" and not inQ[nb] then inQ[nb]=true; q[#q+1]=nb end
                        end
                    end
                end
            elseif rem==nu and rem>0 then
                for u=1,nu do local c=tmpQ[u]
                    if not kF[c] then
                        kF[c]=true; board.flagged[c]=true; any=true
                        for _,nb in ipairs(c.neigh) do
                            if nb.kind=="clue" and not inQ[nb] then inQ[nb]=true; q[#q+1]=nb end
                        end
                    end
                end
            end
        end
    end
    return any
end

local function solve()
    if not state.cx or not state.cz or cols==0 or rows==0 then return end
    if #board.revealed==0 then board.flagged={}; board.cleared={}; board.probs={}; return end

    board.flagged={}; board.cleared={}; board.probs={}
    local kF={}; local kC={}

    propagate(kF,kC)

    if USE_PATTERNS then
        if runPatterns(kF,kC) then propagate(kF,kC) end
    end

    if not next(board.flagged) and not next(board.cleared) then
        if runLocalSolver(kF,kC) then propagate(kF,kC) end
    end

    local fset={}; local flist={}
    for i=1,#board.revealed do
        local cell=board.revealed[i]
        local nu=neighbors(cell,kF,kC,tmpQ)
        for u=1,nu do local c=tmpQ[u]
            if not fset[c] then fset[c]=true; flist[#flist+1]=c end
        end
    end

    local idOf={}; for i=1,#flist do idOf[flist[i]]=i end

    local cons={}
    for i=1,#board.revealed do
        local cell=board.revealed[i]
        local nu,fc=neighbors(cell,kF,kC,tmpQ)
        local rem=(cell.clue or 0)-fc
        if rem>=0 and nu>0 then
            local ix={}; for u=1,nu do ix[#ix+1]=idOf[tmpQ[u]] end
            if #ix>0 then cons[#cons+1]={ix=ix,r=rem} end
        end
    end

    local par,rnk={},{}
    for i=1,#flist do par[i]=i; rnk[i]=0 end
    local function fp(x)
        while par[x]~=x do par[x]=par[par[x]]; x=par[x] end; return x
    end
    local function fu(a,b)
        local ra,rb=fp(a),fp(b); if ra==rb then return end
        if rnk[ra]<rnk[rb] then par[ra]=rb
        elseif rnk[ra]>rnk[rb] then par[rb]=ra
        else par[rb]=ra; rnk[ra]=rnk[ra]+1 end
    end
    for _,c in ipairs(cons) do
        local first=c.ix[1]; for j=2,#c.ix do fu(first,c.ix[j]) end
    end

    local byRoot={}
    for i=1,#flist do
        local r=fp(i); local g=byRoot[r]
        if not g then g={}; byRoot[r]=g end
        g[#g+1]=i
    end
    local comps={}; for _,g in pairs(byRoot) do comps[#comps+1]=g end

    local cdata={}
    for ci=1,#comps do
        local comp=comps[ci]; local sz=#comp
        local grp={}; for i=1,sz do grp[i]=flist[comp[i]] end
        local cm={}; for i=1,sz do cm[comp[i]]=i end
        local lc={}
        for _,c in ipairs(cons) do
            local li={}
            for _,j in ipairs(c.ix) do local l=cm[j]; if l then li[#li+1]=l end end
            if #li>0 then lc[#lc+1]={ix=li,r=c.r} end
        end
        local agg=(sz<=(MAX_COMP_SIZE+6) and #lc<=(MAX_COMP_SIZE+8))
        if (sz<=MAX_COMP_SIZE or agg) and #lc>0 then
            local t,h,lo,hi,d,pk,_,capped=enumerateCached(grp,lc,SOLUTION_LIMIT)
            if t and t>0 and not capped then
                cdata[#cdata+1]={grp=grp,lo=lo,hi=hi,t=t,d=d,pk=pk}
                for i=1,#grp do board.probs[grp[i]]=h[i]/t end
            else
                cdata[#cdata+1]={grp=grp,lo=0,hi=sz,t=0}
            end
        else
            cdata[#cdata+1]={grp=grp,lo=0,hi=sz,t=0}
        end
    end

    local allEnum=true
    for i=1,#cdata do if not cdata[i].d then allEnum=false; break end end

    if allEnum and MINE_COUNT>0 then
        local fc=0; for _ in pairs(kF) do fc=fc+1 end
        local rem=math.max(0,MINE_COUNT-fc)
        local outside=0
        for _,c in pairs(board.cells) do
            if c.hidden==true and not fset[c] and not kF[c] and not kC[c] then
                outside=outside+1
            end
        end
        local co={}; for t=0,outside do co[t]=choose(outside,t) end
        local dp={[0]=1.0}
        for i=1,#cdata do
            local ci=cdata[i]; local ndp={}
            for kp,wp in pairs(dp) do
                for kt=0,#ci.d do
                    local wt=ci.d[kt] or 0
                    if wt>0 then ndp[kp+kt]=(ndp[kp+kt] or 0)+wp*wt end
                end
            end
            dp=ndp
        end
        local totalW=0.0
        for x,w in pairs(dp) do
            local t=rem-x
            if t>=0 and t<=outside then totalW=totalW+w*(co[t] or 0) end
        end
        if totalW>0 then
            local pre={}; pre[0]={[0]=1.0}
            for i=1,#cdata do
                local prev=pre[i-1]; local cur={}; local ci=cdata[i]
                for kp,wp in pairs(prev) do
                    for kt=0,#ci.d do
                        local wt=ci.d[kt] or 0
                        if wt>0 then cur[kp+kt]=(cur[kp+kt] or 0)+wp*wt end
                    end
                end
                pre[i]=cur
            end
            local suf={}; suf[#cdata+1]={[0]=1.0}
            for i=#cdata,1,-1 do
                local nxt=suf[i+1]; local cur={}; local ci=cdata[i]
                for kn,wn in pairs(nxt) do
                    for kt=0,#ci.d do
                        local wt=ci.d[kt] or 0
                        if wt>0 then cur[kn+kt]=(cur[kn+kt] or 0)+wn*wt end
                    end
                end
                suf[i]=cur
            end
            for i=1,#cdata do
                local ci=cdata[i]
                if ci.d and ci.pk and ci.t and ci.t>0 then
                    local dO={}
                    for ka,wa in pairs(pre[i-1]) do
                        for kb,wb in pairs(suf[i+1]) do dO[ka+kb]=(dO[ka+kb] or 0)+wa*wb end
                    end
                    local G={}
                    for kt=0,#ci.d do
                        local s=0.0
                        for ko,wo in pairs(dO) do
                            local t=rem-(kt+ko)
                            if t>=0 and t<=outside then s=s+wo*(co[t] or 0) end
                        end
                        G[kt]=s
                    end
                    for j=1,#ci.grp do
                        local pk=ci.pk[j]; local num=0.0
                        for kt,w in pairs(pk) do num=num+w*(G[kt] or 0.0) end
                        local p=num/totalW
                        board.probs[ci.grp[j]]=p
                        if p<=1e-12 then
                            if not kC[ci.grp[j]] then kC[ci.grp[j]]=true; board.cleared[ci.grp[j]]=true end
                        elseif (1-p)<=1e-12 then
                            if not kF[ci.grp[j]] then kF[ci.grp[j]]=true; board.flagged[ci.grp[j]]=true end
                        end
                    end
                end
            end
        end
    end

    local acc={}
    for i=1,#board.revealed do
        local cell=board.revealed[i]
        local nu,fc=neighbors(cell,kF,kC,tmpQ)
        local rem=(cell.clue or 0)-fc
        if rem>0 and nu>0 then
            local pe=rem/nu
            local tg=1-(min(rem,nu-rem)/max(nu,1))
            for u=1,nu do local c=tmpQ[u]
                if not kF[c] and not kC[c] then
                    local e=acc[c]
                    if not e then e={n=0,p={},t={},ps=1.0}; acc[c]=e end
                    e.n=e.n+1; e.p[e.n]=pe; e.t[e.n]=tg; e.ps=e.ps*(1-pe)
                end
            end
        end
    end
    for cell,e in pairs(acc) do
        if not kF[cell] and not kC[cell] and not board.probs[cell] then
            if e.n==1 then
                board.probs[cell]=e.p[1]
            else
                local pno=1-e.ps; local ws,ts=0,0
                for i=1,e.n do local w=e.t[i]+0.1; ws=ws+e.p[i]*w; ts=ts+w end
                local pw=ws/ts; local p
                if pno>=0.5 and pw>=0.5 then p=max(pno,pw)
                elseif pno<=0.5 and pw<=0.5 then p=min(pno,pw)
                else p=pw end
                board.probs[cell]=p
            end
        end
    end

    for c in pairs(board.flagged)  do board.cleared[c]=nil; board.probs[c]=nil end
    for c in pairs(board.cleared) do board.flagged[c]=nil;  board.probs[c]=nil end
end

local function hashParts(parts)
    local n=#parts; if n==0 then return "0" end
    local step=math.max(1,floor(n/12)); local a={tostring(n)}; local k=1
    for i=1,n,step do
        local p=parts[i]; local pos=p and p.Position
        if pos then a[#a+1]=tostring(floor(pos.X*10+0.5))..","..tostring(floor(pos.Z*10+0.5)) end
        k=k+1; if k>12 then break end
    end
    return table.concat(a,"|")
end

local function needsRebuild()
    local root=workspace:FindFirstChild("Flag"); if not root then return true end
    local folder=root:FindFirstChild("Parts"); if not folder then return true end
    local parts=folder:GetChildren(); local n=#parts; local h=hashParts(parts)
    if state.folder~=folder then state.folder=folder; state.partCount=n; state.partHash=h; return true end
    if state.partCount~=n then state.partCount=n; state.partHash=h; return true end
    if state.partHash~=h then state.partHash=h; return true end
    return false
end

local function fullReset()
    state.cx=nil; state.cz=nil; cols=0; rows=0
    board.cells={}; board.revealed={}; board.rows={}; board.flat={}
    state.tick=0; state.lastTick=-1
    ecacheClear()
end

-- drawing pool
local pool={}; local poolN=0; local poolUsed=0

local function getLabel()
    poolUsed=poolUsed+1
    if poolUsed<=poolN then local d=pool[poolUsed]; d.Visible=true; return d end
    local d=Drawing.new("Text",{Size=13,Center=true,Outline=true,OutlineColor=BLACK,Color=RED,Visible=false})
    poolN=poolN+1; pool[poolN]=d; return d
end

local function hideExtra()
    for i=poolUsed+1,poolN do pool[i].Visible=false end
end

local function project(cell)
    local pos=(cell.part and cell.part.Position) or cell.pos
    if not pos then return nil,nil end
    local sc,on=pos:WorldToScreen()
    if not on then return nil,nil end
    return floor(sc.X+0.5), floor(sc.Y+0.5)
end

local function pct(p)
    return string.format("%d%%",floor(floor(p*20+0.5)/20*100+0.5))
end

local function draw()
    poolUsed=0

    for cell in pairs(board.cleared or {}) do
        -- skip if this cell is also flagged — mine takes priority
        if not board.flagged[cell] then
            local sx,sy=project(cell)
            if sx and sy then
                local d=getLabel(); d.Text="S"; d.Color=MINT; d.Size=15
                d.Position=Vector2.new(sx,sy-6)
                local d2=getLabel(); d2.Text="clr"; d2.Color=MINT_DIM; d2.Size=10
                d2.Position=Vector2.new(sx,sy+8)
            end
        end
    end

    for cell,p in pairs(board.probs or {}) do
        if not board.flagged[cell] and not board.cleared[cell] then
            local sx,sy=project(cell)
            if sx and sy then
                if p>=MINE_THRESHOLD then
                    local d=getLabel(); d.Text=pct(p); d.Color=HOT_RED; d.Size=14
                    d.Position=Vector2.new(sx,sy-6)
                    local d2=getLabel(); d2.Text="mine?"; d2.Color=HOT_RED2; d2.Size=10
                    d2.Position=Vector2.new(sx,sy+8)
                elseif p<=SAFE_THRESHOLD then
                    local d=getLabel(); d.Text=pct(1-p); d.Color=SKY; d.Size=14
                    d.Position=Vector2.new(sx,sy-6)
                    local d2=getLabel(); d2.Text="safe?"; d2.Color=SKY_DIM; d2.Size=10
                    d2.Position=Vector2.new(sx,sy+8)
                else
                    local d=getLabel(); d.Text=pct(p); d.Color=AMBER; d.Size=14
                    d.Position=Vector2.new(sx,sy-6)
                    local d2=getLabel(); d2.Text="idk"; d2.Color=AMBER_DIM; d2.Size=10
                    d2.Position=Vector2.new(sx,sy+8)
                end
            end
        end
    end

    -- draw flagged last so mines always render on top
    for cell in pairs(board.flagged or {}) do
        local sx,sy=project(cell)
        if sx and sy then
            local d=getLabel(); d.Text="M"; d.Color=RED; d.Size=15
            d.Position=Vector2.new(sx,sy-6)
            local d2=getLabel(); d2.Text="!!!"; d2.Color=RED_DIM; d2.Size=11
            d2.Position=Vector2.new(sx,sy+8)
        end
    end

    hideExtra()
end

local frame=0

task.spawn(function()
    local solveNext = false
    while true do
        frame=frame+1
        local ok,err=pcall(function()
            if needsRebuild() then fullReset() end
            if gridReady() then
                readBoard()
                if state.tick~=state.lastTick then
                    state.lastTick=state.tick
                    solve()
                    solveNext=true  -- run again next tick once reads settle
                elseif solveNext then
                    solveNext=false
                    solve()
                end
            end
            draw()
        end)
        if not ok then print("[solver] error: "..tostring(err)) end
        task.wait(0)
    end
end)

print("[solver] ready.")
